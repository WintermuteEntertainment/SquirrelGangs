# Text files (treat as text, normalize line endings on commit, native on checkout)
*.cs                text diff=csharp
*.shader            text
*.cginc             text
*.hlsl              text
*.glsl              text
*.compute           text
*.uxml              text
*.uss               text
*.json              text
*.xml               text
*.yaml              text
*.yml               text
*.md                text
*.txt               text

# Unity asset files are YAML — treat as text
*.unity             text
*.prefab            text
*.asset             text
*.mat               text
*.controller        text
*.anim              text
*.physicMaterial    text
*.physicsMaterial2D text
*.meta              text
*.lighting          text
*.preset            text
*.spriteatlas       text

# Binary assets → Git LFS
# Images
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
